{
  "info": {
    "name": "Tiendarte API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Prueba\",\n  \"email\": \"prueba@tiendarte.com\",\n  \"password\": \"prueba123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Iniciar sesion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"prueba@tiendarte.com\",\n  \"password\": \"prueba123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Perfil con token vencido",
          "request": {
            "description": "Enviar despues de 5 minutos de iniciar sesion. Responde 401 con error token_expired.",
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Recursos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recursos",
              "host": ["{{baseUrl}}"],
              "path": ["recursos"]
            }
          }
        },
        {
          "name": "Filtrar por seccion",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recursos?section=ofertas",
              "host": ["{{baseUrl}}"],
              "path": ["recursos"],
              "query": [
                {
                  "key": "section",
                  "value": "ofertas"
                }
              ]
            }
          }
        },
        {
          "name": "Buscar producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"recursoId\", pm.response.json().recursos[0]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recursos?q=Arcilla",
              "host": ["{{baseUrl}}"],
              "path": ["recursos"],
              "query": [
                {
                  "key": "q",
                  "value": "Arcilla"
                }
              ]
            }
          }
        },
        {
          "name": "Detalle de producto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recursos/{{recursoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["recursos", "{{recursoId}}"]
            }
          }
        },
        {
          "name": "Eliminar producto",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recursos/{{recursoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["recursos", "{{recursoId}}"]
            }
          }
        },
        {
          "name": "Crear producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"recursoId\", pm.response.json().recurso._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Arcilla\",\n  \"description\": \"seca al aire\",\n  \"info\": \"Arcilla blanca de secado al aire, fácil de moldear y adecuada para crear figuras, adornos, esculturas y proyectos escolares. No requiere horno para endurecerse, por lo que resulta práctica tanto para principiantes como para actividades artísticas y manualidades.\",\n  \"price\": 155,\n  \"stock\": 14,\n  \"category\": \"Modelado\",\n  \"image\": \"/item8.webp\",\n  \"section\": \"nuevo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/recursos",
              "host": ["{{baseUrl}}"],
              "path": ["recursos"]
            }
          }
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Arcilla\",\n  \"description\": \"seca al aire\",\n  \"info\": \"Arcilla blanca de secado al aire, fácil de moldear y adecuada para crear figuras, adornos, esculturas y proyectos escolares. No requiere horno para endurecerse, por lo que resulta práctica tanto para principiantes como para actividades artísticas y manualidades.\",\n  \"price\": 155,\n  \"stock\": 14,\n  \"category\": \"Modelado\",\n  \"image\": \"/item8.webp\",\n  \"section\": \"nuevo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/recursos/{{recursoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["recursos", "{{recursoId}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "recursoId",
      "value": ""
    }
  ]
}
